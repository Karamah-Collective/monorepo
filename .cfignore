# Cloudflare Pages publish exclusions
# (overrides .gitignore for CF Pages only)
#
# DO NOT exclude src/config.local.js here —
# it is generated at build time by build-secrets.js
# and must be served to the browser.

node_modules/
.env
.env.local
.env.*.local
scripts/transit-cache.json
scripts/cache/
*.cache
