{"nodes": [{"id": "docs_preference_log_document", "label": "Preference Log", "file_type": "document", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_preference_log_patterns_to_avoid", "label": "Patterns to Avoid", "file_type": "concept", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_preference_log_patterns_to_follow", "label": "Patterns to Follow", "file_type": "concept", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_preference_log_navigation_camera", "label": "Navigation Camera Model", "file_type": "concept", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three discrete zoom/pitch tiers (standard cruising, full turn zoom, highway zoom-out), not a continuous curve; heading derived from route polyline geometry (immune to GPS jitter), GPS-centered follow via a rAF jumpTo loop, always-follow with any manual pan breaking follow instantly."}, {"id": "docs_preference_log_hook_pattern", "label": "Hook Pattern for Circular Module Dependencies", "file_type": "concept", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When module A needs module B but B already imports A, export a setHooks() from A and call it from B at evaluation time to register callbacks, avoiding import cycles."}, {"id": "docs_preference_log_static_site_constraint", "label": "Static-site / Zero-dependency Architecture", "file_type": "rationale", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static site only: no bundler, SSR or frameworks; vanilla JS ES modules; zero runtime dependencies (Playwright dev-only); all server logic in functions/ on V8 Web APIs. React and any framework are explicitly rejected."}, {"id": "docs_preference_log_no_autotest_rule", "label": "No Automated Tests Without Explicit Ask", "file_type": "rationale", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standing rule (2026-08-02): do not run Playwright or any test suite unless the user explicitly asks; a node --check syntax pass is fine but a browser verification pass is not. The user tests every change manually in a real browser."}, {"id": "docs_preference_log_brand_teal", "label": "Brand Teal Accent + Neutral Surfaces", "file_type": "concept", "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand teal #08705B replaces blue as --accent; all surfaces are pure neutral grays (the warm #FDFCF8 is explicitly rejected); AMOLED-black (#000000) dark mode and pure-white light mode with no warm tint on any surface."}], "edges": [{"source": "docs_preference_log_document", "target": "docs_preference_log_patterns_to_avoid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "weight": 1.0}, {"source": "docs_preference_log_document", "target": "docs_preference_log_patterns_to_follow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PREFERENCE_LOG.md", "source_location": null, "weight": 1.0}, {"source": "docs_preference_log_document", "target": "docs_preference_log_navigation_camera", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PREFERENCE_LOG.m