{"nodes": [{"id": "docs_accounts_and_redesign_plan_document", "label": "Accounts & Redesign Plan", "file_type": "document", "source_file": "docs/ACCOUNTS_AND_REDESIGN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_accounts_and_redesign_plan_firebase_auth", "label": "Firebase Authentication", "file_type": "concept", "source_file": "docs/ACCOUNTS_AND_REDESIGN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firebase Auth as the identity layer: Google, Microsoft, email magic-link and email/password sign-in; no Firestore. Project 'Halal Map Karamah' (halal-map-karamah)."}, {"id": "docs_accounts_and_redesign_plan_firebase_token_verify", "label": "Edge Firebase ID Token Verification", "file_type": "concept", "source_file": "docs/ACCOUNTS_AND_REDESIGN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verify Firebase ID tokens at the edge via JWKS RS256 using Web Crypto (functions/_firebase-verify.js), with no server SDK, keeping the app on Cloudflare's V8 runtime."}, {"id": "docs_accounts_and_redesign_plan_email_hash_privacy", "label": "Email Hash Privacy Principle", "file_type": "rationale", "source_file": "docs/ACCOUNTS_AND_REDESIGN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store emailHash = sha256(verified email), never the plaintext email, as the account and review identity key, so no personal email is persisted."}, {"id": "docs_accounts_and_redesign_plan_place_sheet", "label": "Place-detail Bottom Sheet", "file_type": "concept", "source_file": "docs/ACCOUNTS_AND_REDESIGN_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "showPlacePopup() becomes openPlaceSheet() rendering into #p