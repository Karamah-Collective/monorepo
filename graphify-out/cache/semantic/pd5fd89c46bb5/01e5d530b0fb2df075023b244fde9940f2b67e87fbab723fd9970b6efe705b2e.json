{"nodes": [{"id": "docs_design_system_document", "label": "Design System", "file_type": "document", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_design_tokens", "label": "Design Tokens (design-tokens.css)", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_system_template_first", "label": "Template-first CSS / Component Alias Pattern", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every visual pattern must exist as a reusable class in design-tokens.css before being used in styles.css or JS; a JS class that is visually identical to a template is added to the template selector as an alias rather than duplicated."}, {"id": "docs_design_system_premium_utility", "label": "'Premium Utility' Design Vision", "file_type": "rationale", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clean, airy, generous spacing, dramatic typography hierarchy, and consistent radii and animations across components; flat and minimal with very subtle shadows, never glassy, blurry, or HUD-like."}, {"id": "docs_design_system_button_templates", "label": "Button Templates", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully-rounded pill buttons with color/opacity/filter feedback only (no size or transform on hover/press); buttons are either icon-only or text-only, with documented exceptions."}, {"id": "docs_design_system_btn_google_exception", "label": "Third-party Brand Button Exception", "file_type": "rationale", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third-party brand buttons (e.g. .btn-google) follow the vendor's own official button spec over the app palette, using dedicated --google-btn-* tokens; the recognizability and trust of a well-known brand mark outweighs internal color consistency for that one component."}, {"id": "docs_design_system_merged_sheet", "label": "Merged Menu/Profile Sheet", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single #menu-sheet holds two panes on #mp-pane-track, switched by _setActivePane with _syncPaneHeight height syncing."}, {"id": "docs_design_system_sheet_utils", "label": "Sheet Animation Utilities", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "animateElementHeight(), crossFadeSwap() and initSheetDrag() in src/utils.js drive sheet height animation, pane cross-fades and drag-to-dismiss."}, {"id": "docs_design_system_show_confirm_dialog", "label": "showConfirmDialog() Confirmation Pattern", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One reusable Yes/No dialog (showConfirmDialog() plus .confirm-overlay/.confirm-card) replaces the now-obsolete press-twice-to-confirm pattern for review delete and sign-out."}, {"id": "docs_design_system_reduce_motion", "label": "Reduce Motion Single-source Mechanism", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single JS-computed html.reduce-motion class, fed by a localStorage override else the live matchMedia value, so every motion check in CSS and JS reads one source of truth instead of a parallel bare @media block."}, {"id": "docs_design_system_plus_jakarta_sans", "label": "Plus Jakarta Sans Typeface", "file_type": "concept", "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project typeface replacing Inter/General Sans; high x-height, crisp ClearType hinting, self-hosted with latin and latin-ext subsets for Finnish characters."}], "edges": [{"source": "docs_design_system_document", "target": "docs_design_system_design_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_document", "target": "docs_design_system_template_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_document", "target": "docs_design_system_premium_utility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_document", "target": "docs_design_system_button_templates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_document", "target": "docs_design_system_btn_google_exception", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/DESIGN_SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "docs_design_system_document", "target": "docs_design_system_merged_sheet", "relation