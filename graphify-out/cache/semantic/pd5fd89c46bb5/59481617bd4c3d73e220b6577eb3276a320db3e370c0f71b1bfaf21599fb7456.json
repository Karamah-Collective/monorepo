{"nodes": [{"id": "docs_d1_migration_plan_document", "label": "Google Sheets to Cloudflare D1 Migration Plan", "file_type": "document", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_d1_migration_plan_cloudflare_d1", "label": "Cloudflare D1 Database", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because the app is already 100% Cloudflare Pages: D1 binds directly into the existing Functions with zero extra network hop, and its free tier covers current and near-future scale. It replaces the slow external Apps Script HTTP hop and its public, unauthenticated exec URL."}, {"id": "docs_d1_migration_plan_apps_script_backend", "label": "Google Sheets + Apps Script Backend (legacy)", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_d1_migration_plan_d1_schema", "label": "D1 Schema (14 tables)", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "14 tables plus indexes; the Verifications table is intentionally dropped because Firebase Auth now covers identity."}, {"id": "docs_d1_migration_plan_reviews_upsert", "label": "Reviews Upsert via UNIQUE(place_id, email_hash)", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces Code.gs's scan-then-branch logic with a single upsert keyed on the (place_id, email_hash) unique constraint."}, {"id": "docs_d1_migration_plan_otp_retirement", "label": "Legacy Anonymous OTP Review Flow Retirement", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firebase Auth already covers identity end-to-end, so send-otp/verify-otp and the Verifications table are dropped entirely (also removing the only need for a new outbound-email dependency). Historical OTP-submitted review rows still migrate as normal data; only the creation mechanism is retired."}, {"id": "docs_d1_migration_plan_nominatim_geocoding", "label": "Server-side Nominatim Geocoding", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side enrichment reuses the free, keyless OpenStreetMap Nominatim endpoint the app already calls client-side instead of GAS Maps.newGeocoder(), so the migration needs zero new third-party vendor signups."}, {"id": "docs_d1_migration_plan_promotion_deploy", "label": "Promotion-based Deploy (deploy/preview branches)", "file_type": "concept", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cloudflare Pages here builds only the deploy (production) and preview branches, not arbitrary pushed branches. Changes reach them by promoting curated files via git checkout <source> -- <file-list>, deliberately excluding package.json and wrangler.toml, which each branch keeps its own copy of."}, {"id": "docs_d1_migration_plan_on_conflict_partial_index", "label": "ON CONFLICT Partial-Index Match Requirement", "file_type": "rationale", "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite requires an ON CONFLICT target to repeat a partial unique index's WHERE clause exactly (idx_saved_places_placeid_kinds WHERE kind IN ('favorite','visited')) or it throws 'ON CONFLICT clause does not match any PRIMARY KEY or UNIQUE constraint' instead of matching."}], "edges": [{"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_cloudflare_d1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_apps_script_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_d1_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_reviews_upsert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_otp_retirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_nominatim_geocoding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "docs_d1_migration_plan_document", "target": "docs_d1_migration_plan_promotion_deploy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/D1_MIGRATION_PLAN.md", "source_location": null, "weight": 1.0}