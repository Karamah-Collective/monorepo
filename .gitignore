# ════════════════════════════════════════════════════════════════
# LOCAL SECRETS & GENERATED FILES (Never commit)
# ════════════════════════════════════════════════════════════════

# Configuration files with actual keys
Maps/src/config.local.js
/.local-backups/
/.venv/
# src/config.js is tracked — it contains no secrets (reads from /api/config at runtime)
.env
.env.local
.env.*.local
.dev.vars
Maps/scripts/apps-script/Code.gs


# Generated/cached files — transit cache IS committed (deployed to Cloudflare Pages)
Maps/scripts/cache/
Maps/scripts/local-backups/
*.cache

# D1 migration (see docs/D1_MIGRATION_PLAN.md) — local dev state and
# generated one-time migration SQL, never committed
.wrangler/
Maps/scripts/migrate-to-d1/generated/
Website/.local/

# Playwright generated output
playwright-report/
test-results/

# Local development documentation
Maps/docs/GIT_TRACKING.md
Maps/docs/FORMS_SHEETS_SETUP.md
Maps/docs/user-guide.css
Maps/docs/user-guide.html
Maps/docs/guide-images/
Maps/scripts/capture-guide-screenshots.js

