# Copy to Website/.dev.vars for local API development. Never commit credentials.
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
WEBSITE_ADMIN_KEY=
WEBSITE_FORM_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BREVO_API_KEY=
# Optional: exact trusted HTTPS Admin preview origins, comma-separated.
ADMIN_ALLOWED_ORIGINS=

# Must match Maps/.dev.vars for local MCP service assertions.
MCP_INTERNAL_SIGNING_KEY=local-mcp-signing-key-change-me-32-characters
