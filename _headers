# Cloudflare Pages – response headers
# ═══════════════════════════════════════════════════════════════════════

# ─── Global security headers (apply to every response) ────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), autoplay=(), encrypted-media=(), picture-in-picture=(), geolocation=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com/maplibre-gl@3.6.2/ https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' https://unpkg.com/maplibre-gl@3.6.2/ 'unsafe-inline'; connect-src 'self' https://unpkg.com/maplibre-gl@3.6.2/ https://api.digitransit.fi https://api.transitous.org https://nominatim.openstreetmap.org https://routing.openstreetmap.de https://tiles.openfreemap.org https://s3.amazonaws.com/elevation-tiles-prod/ https://api.aladhan.com https://www.google.com/recaptcha/ https://overpass-api.de https://overpass.kumi.systems https://maps.mail.ru https://clarity.maptiles.arcgis.com; img-src 'self' data: blob: https://clarity.maptiles.arcgis.com; font-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; frame-src https://www.google.com/recaptcha/; base-uri 'self'; form-action 'self'; object-src 'none'

# ─── Service worker — never cache ─────────────────────────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Service-Worker-Allowed: /

# ─── Static assets — long cache with version-busted URLs ──────────────
/src/*
  Cache-Control: private, max-age=31536000, immutable
/data/places.json
  Cache-Control: private, no-store
/data/tags.json
  Cache-Control: private, no-store
/data/icons/*
  Cache-Control: public, max-age=31536000, immutable
/data/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/data/halal-finder-preview.png
  Cache-Control: public, max-age=604800
