{
  "name": "karamah-monorepo",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "impeccable": "^4.5.2",
    "zod": "^3.25.76"
  },
  "workspaces": [
    "Maps",
    "Website",
    "Admin",
    "Links",
    "Forms",
    "Projects"
  ],
  "scripts": {
    "dev": "node tooling/dev.mjs",
    "dev:maps": "node tooling/dev.mjs maps",
    "dev:website": "node tooling/dev.mjs website",
    "dev:admin": "node tooling/dev.mjs admin",
    "dev:links": "node tooling/dev.mjs links",
    "dev:forms": "node tooling/dev.mjs forms",
    "dev:projects": "node tooling/dev.mjs projects",
    "migrate:form-links": "node Forms/scripts/shorten-share-codes.mjs",
    "migrate:admin-data": "node scripts/migrate-admin-data.mjs",
    "migrate:projects-db": "node scripts/migrate-projects-db.mjs",
    "migrate:projects-db:local": "node scripts/migrate-projects-db.mjs --local",
    "check:local": "node scripts/check-local-databases.mjs",
    "cleanup:projects-live": "node scripts/cleanup-project-live-fixtures.mjs",
    "retire:admin-data": "node scripts/retire-legacy-admin-data.mjs",
    "setup:website": "node tooling/setup-website-env.mjs",
    "deploy:agent": "node tooling/deploy-agent.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:maps": "npm run build --workspace Maps",
    "build:website": "npm run build --workspace Website",
    "build:admin": "npm run build --workspace Admin",
    "build:links": "npm run build --workspace Links",
    "build:forms": "npm run build --workspace Forms",
    "build:projects": "npm run build --workspace Projects",
    "test:admin": "playwright test --config Admin/tests/playwright.config.js",
    "test:maps": "playwright test --config Maps/tests/playwright.config.js",
    "test:maps:smoke": "playwright test --config Maps/tests/playwright.config.js Maps/tests/01-dom-elements.spec.js -g \"app container and map canvas exist|map canvas has non-zero dimensions|tab bar exists\" --project \"Desktop Chrome\"",
    "test:website": "node --test Website/tests/*.test.mjs",
    "test:website:ui": "playwright test --config Website/tests/playwright.config.js",
    "test:links": "playwright test --config Links/tests/playwright.config.js",
    "test:forms": "node --test Forms/tests/*.test.mjs",
    "test:mcp": "node --experimental-test-isolation=none --test tests/admin-mcp-*.test.mjs",
    "test:projects": "node --experimental-test-isolation=none --test tests/projects-privacy.test.mjs",
    "test:projects:ui": "playwright test --config Projects/tests/playwright.config.js",
    "test:forms:ui": "playwright test --config Forms/tests/playwright.config.js",
    "check": "node tooling/check-layout.mjs",
    "docs:check": "node tooling/check-docs.mjs",
    "update": "npm run update --workspace Maps",
    "update:force": "npm run update:force --workspace Maps"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "serve": "^14.2.5",
    "wrangler": "^4.131.2",
    "xlsx": "^0.18.5"
  }
}
